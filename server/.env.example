# Copy to server/.env for local development. On a host, set these in its dashboard.
NODE_ENV=development
PORT=4175
# Defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.
HOST=
# Number of reverse proxies in front of the app (1 on Render, Railway, Fly, Nginx).
TRUST_PROXY=0
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174

# PostgreSQL. Leave empty to run without a database (the bundled site list is used).
# Local Docker:
DATABASE_URL=postgres://terra:terra@localhost:5432/terra
# Neon: paste the POOLED connection string from the dashboard (host contains "-pooler").
# It already ends with ?sslmode=require, which verifies Neon's certificate.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Only needed when the URL has no ?sslmode= and the database still requires TLS.
DATABASE_SSL=false

# Optional. Enables POST /api/analog/reload (header x-admin-token) in production.
ADMIN_TOKEN=
