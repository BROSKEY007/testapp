PORT=3001
# Path to the dataset CSV (defaults to data/nasa_sites.csv)
DATA_PATH=data/nasa_sites.csv
# Trained model (defaults to model/analog-model.json, create it with npm run train)
# MODEL_PATH=model/analog-model.json
# Optional alternate column mapping file (defaults to config/columns.json)
# COLUMNS_PATH=config/columns.json
# Comma-separated allowed origins for the standalone server (defaults to *)
# CORS_ORIGINS=https://your-frontend.example.com
# Secret for POST /api/analog/reload (send it as header x-admin-token).
# In production, reload is disabled unless this is set.
# ADMIN_TOKEN=change-me
