{
  "name": "@terra/server",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "catalog": "node scripts/generate-catalog.js",
    "train": "node analog-engine/scripts/train.js && node scripts/generate-catalog.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@terra/shared": "*",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "express": "5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.13.0"
  }
}
